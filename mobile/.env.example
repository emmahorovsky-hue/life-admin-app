# Expo loads this directory's .env automatically when evaluating app.config.ts,
# so anything here is available as process.env.* there (and only there — these
# are build-time values, not runtime secrets). Copy to `.env` and fill in.
#
# Never commit `.env` itself: the root .gitignore covers it and CI's
# env-file-guard job fails the build if a .env file is ever tracked.

# API base URL for local development. Optional — lib/api.ts falls back to
# localhost under __DEV__. Release builds get this from mobile/eas.json
# (build.<profile>.env.API_URL) or an EAS environment variable, and
# app.config.ts throws rather than let a production build ship without it.
# API_URL=http://localhost:3001/api

# Brand logos on subscription rows (logo.dev), surfaced as extra.logoDevToken
# and read by lib/subscriptionLogo.ts. Publishable token, safe to ship in the
# app bundle — but this repo is public, so it stays out of git and out of
# eas.json. Use the same token as the web client's VITE_LOGO_DEV_TOKEN.
# Without it, rows fall back to the category icon (feature degrades gracefully).
# For EAS builds, set it as an EAS environment variable — see DEPLOYMENT.md 6.2.
# LOGO_DEV_TOKEN=pk_...
